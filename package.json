{
  "name": "developer-portfolio",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Minimal terminal-themed developer portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "prepare": "husky install"
  },
  "keywords": [
    "portfolio",
    "developer",
    "terminal",
    "minimal",
    "react",
    "vite"
  ],
  "author": "Philipp Trubchenko",
  "license": "MIT",
  "homepage": "https://github.com/philtru/philtru.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/philtru/philtru.me.git"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^8.0.3",
    "lint-staged": "^17.6.2",
    "vite": "^6.4.6"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "js-yaml": ">=4.3.2",
      "brace-expansion": ">=1.1.18",
      "browserslist": ">=4.28.7",
      "minimatch": ">=3.1.4",
      "picomatch": ">=2.3.2",
      "flatted": ">=3.4.0",
      "ajv": ">=6.14.0 <7",
      "yaml": ">=2.8.3",
      "baseline-browser-mapping": ">=2.11.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
